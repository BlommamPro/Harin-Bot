{
  "name": "discord-bot-base",
  "version": "1.1.9",
  "type": "module",
  "main": "src/index.js",
  "author": "BlommamPro",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file=.env.dev --watch src/index.js",
    "cmd:deploy": "node src/utils/deployCommands.js",
    "cmd:deploy:dev": "node --env-file=.env.dev src/utils/deployCommands.js",
    "cmd:delete": "node src/utils/deleteCommands.js",
    "cmd:delete:dev": "node --env-file=.env.dev src/utils/deleteCommands.js",
    "cmd:list": "node src/utils/listCommands.js",
    "cmd:list:dev": "node --env-file=.env.dev src/utils/listCommands.js",
    "cmd:reset": "node src/utils/deleteCommands.js && node src/utils/deployCommands.js",
    "cmd:reset:dev": "node --env-file=.env.dev src/utils/deleteCommands.js && node --env-file=.env.dev src/utils/deployCommands.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.7",
    "mongoose": "^8.15.0",
    "chalk": "^5.4.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}